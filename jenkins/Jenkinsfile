// ======================================================
// Jenkinsfile
// Project : pyats-config-push
// Version : v2.1.2
//
// ------------------------------------------------------
// FIXES IN v2.1.2
// ------------------------------------------------------
//
// ❌ PROBLEM (v2.1.1):
// - Python script (--list-devices) returns devices
//   one-per-line (newline separated)
// - Jenkinsfile incorrectly split on commas
// - Result: ALL devices treated as ONE string
//
// ✅ FIX (v2.1.2):
// - Split device list by newline instead of comma
// - Trim empty lines
// - Validate device discovery before running parallel
//
// ======================================================

pipeline {
    agent any

    options {
        timestamps()
        ansiColor('xterm')
    }

    parameters {
        text(
            name: 'CONFIG',
            description: 'CLI configuration to push (raw commands)',
            trim: true
        )
        booleanParam(
            name: 'WRITE_MEMORY',
            defaultValue: true,
            description: 'Save configuration after push'
        )
    }

    environment {
        PYTHON_BIN = 'python3.11'
        VENV_DIR  = 'pyats-venv'
        TESTBED   = 'testbeds/testbed_access_2960.yaml'
    }

    stages {

        // --------------------------------------------------
        stage('Task 1 - Checkout SCM') {
            steps {
                checkout scm
                echo '✅ Repo checked out (SCM)'
            }
        }

        // --------------------------------------------------
        stage('Task 2.1 - Verify Python') {
            steps {
                sh '''
                    set -e
                    echo "Using Python:"
                    python3.11 --version
                '''
            }
        }

        // --------------------------------------------------
        stage('Task 2.2 - Create / Reuse Virtualenv') {
            steps {
                sh '''
                    set -e
                    if [ ! -d "${VENV_DIR}" ]; then
                        python3.11 -m venv ${VENV_DIR}
                    else
                        echo "Virtualenv already exists, reusing it"
                    fi
                '''
            }
        }

        // --------------------------------------------------
        stage('Task 2.3 - Install Python dependencies') {
            steps {
                sh '''
                    set -e
                    . ${VENV_DIR}/bin/activate
                    python -m pip install --upgrade pip

                    if [ -f requirements.txt ]; then
                        pip install -r requirements.txt
                    else
                        pip install pyats==24.3 genie==24.3 unicon==24.3
                    fi
                '''
            }
        }

        // --------------------------------------------------
        stage('Task 2.4 - Verify Imports') {
            steps {
                sh '''
                    set -e
                    . ${VENV_DIR}/bin/activate
                    python - << 'EOF'
import pyats, genie, unicon
print("pyATS import OK")
print("Genie import OK")
print("Unicon import OK")
EOF
                '''
            }
        }

        // --------------------------------------------------
        stage('Task 3 - Push Config (Parallel per Device)') {
            steps {
                script {

                    // ----------------------------------------------
                    // Discover devices (newline-separated output)
                    // ----------------------------------------------
                    def rawOutput = sh(
                        script: """
                            . ${VENV_DIR}/bin/activate
                            ${PYTHON_BIN} scripts/config_push.py \
                              --testbed ${TESTBED} \
                              --list-devices
                        """,
                        returnStdout: true
                    ).trim()

                    // ----------------------------------------------
                    // ✅ FIX v2.1.2: split by newline, not comma
                    // ----------------------------------------------
                    def devices = rawOutput
                        .split('\\n')
                        .collect { it.trim() }
                        .findAll { it }

                    if (devices.isEmpty()) {
                        error "❌ No devices discovered from testbed"
                    }

                    echo "Discovered devices: ${devices}"

                    def branches = [:]

                    devices.each { dev ->
                        def deviceName = dev  // capture correctly

                        branches[deviceName] = {
                            stage("Push → ${deviceName}") {
                                sh """
                                    set -e
                                    . ${VENV_DIR}/bin/activate
                                    ${PYTHON_BIN} scripts/config_push.py \
                                      --testbed ${TESTBED} \
                                      --devices ${deviceName} \
                                      --config "${params.CONFIG}" \
                                      ${params.WRITE_MEMORY ? '--write-memory' : ''}
                                """
                            }
                        }
                    }

                    parallel branches
                }
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline completed successfully'
        }
        failure {
            echo '❌ Pipeline failed – check logs'
        }
    }
}
