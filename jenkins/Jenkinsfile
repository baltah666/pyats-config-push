/*
===============================================================================
 Jenkinsfile – pyats-config-push-v2
 Version : v2.5.0
-------------------------------------------------------------------------------
 PURPOSE:
 - Push IOS configuration to multiple devices using pyATS + Genie
 - Support MULTIPLE testbeds selected at once (checkbox style)
 - Run per-device in parallel (inside each testbed)
 - Safe Jenkins virtualenv handling

 WHAT'S NEW IN v2.5.0:
 - TESTBEDS parameter is now a MULTI-SELECT CHECKBOX list
 - Operator can select ONE or MORE testbed YAML files
 - Jenkins will loop testbeds sequentially
 - Devices inside each testbed run in PARALLEL
 - Matches requested UI style (checkbox list)

 PREVIOUS FIXES:
 v2.4.0
 - Stable pipeline structure
 - Clean git handling

 v2.3.0
 - Introduced Active Choices (single-select)

 v2.2.1
 - Explicit pyats-venv/bin/python usage
 - Fixed "ModuleNotFoundError: pyats"

 REQUIREMENTS:
 - Jenkins Active Choices Plugin
 - Python 3.11 available on Jenkins agent
===============================================================================
*/

pipeline {
    agent any

    options {
        timestamps()
        ansiColor('xterm')
    }

    /***************************************************************************
     PARAMETERS
    ***************************************************************************/
    parameters {

        /*
         ----------------------------------------------------------------------
         TESTBEDS (MULTI-SELECT CHECKBOX)
         ----------------------------------------------------------------------
         - Uses Active Choices Plugin
         - Allows selecting ONE or MORE testbeds
         - Values returned as comma-separated string
        */
        activeChoiceParam('TESTBEDS') {
            description('Select one or more target testbeds')
            choiceType('CHECKBOX')

            groovyScript {
                script("""
                    return [
                        'testbeds/testbed_access_2960.yaml',
                        'testbeds/testbed_access_9200.yaml',
                        'testbeds/testbed_access_9300.yaml',
                        'testbeds/testbed_datacenter_n9k.yaml',
                        'testbeds/testbed_routers.yaml'
                    ]
                """)
                fallbackScript("return ['ERROR_LOADING_TESTBEDS']")
            }
        }

        /*
         ----------------------------------------------------------------------
         CONFIG_COMMANDS
         ----------------------------------------------------------------------
        */
        text(
            name: 'CONFIG_COMMANDS',
            defaultValue: '',
            description: 'Multiline IOS CLI configuration to push'
        )

        /*
         ----------------------------------------------------------------------
         DEVICE_FILTER
         ----------------------------------------------------------------------
        */
        string(
            name: 'DEVICE_FILTER',
            defaultValue: 'ALL',
            description: 'Comma-separated device list OR ALL'
        )

        /*
         ----------------------------------------------------------------------
         WRITE_MEMORY
         ----------------------------------------------------------------------
        */
        booleanParam(
            name: 'WRITE_MEMORY',
            defaultValue: true,
            description: 'Run "write memory" after pushing config'
        )
    }

    /***************************************************************************
     STAGES
    ***************************************************************************/
    stages {

        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        stage('Prepare Virtualenv') {
            steps {
                sh '''
                    set -e
                    if [ ! -d pyats-venv ]; then
                        python3.11 -m venv pyats-venv
                    fi
                    pyats-venv/bin/pip install --upgrade pip
                    pyats-venv/bin/pip install pyats==24.3 genie==24.3 unicon==24.3
                '''
            }
        }

        stage('Verify pyATS Environment') {
            steps {
                sh '''
                    set -e
                    pyats-venv/bin/python - << 'EOF'
import pyats, genie, unicon
print("pyATS environment OK")
EOF
                '''
            }
        }

        /*
         ----------------------------------------------------------------------
         MAIN EXECUTION
         ----------------------------------------------------------------------
         - Loop over selected testbeds
         - Devices inside each testbed run in parallel
        */
        stage('Push Config (Per Testbed)') {
            steps {
                script {

                    if (!params.TESTBEDS?.trim()) {
                        error "No testbeds selected!"
                    }

                    def testbeds = params.TESTBEDS
                        .split(',')
                        .collect { it.trim() }
                        .findAll { it }

                    for (tb in testbeds) {

                        stage("Testbed → ${tb}") {

                            def devicesRaw = sh(
                                script: """
                                    pyats-venv/bin/python scripts/config_push.py \
                                      --testbed ${tb} \
                                      --list-devices
                                """,
                                returnStdout: true
                            ).trim()

                            def devices = devicesRaw
                                .split("\\n")
                                .collect { it.trim() }
                                .findAll { it }

                            if (devices.isEmpty()) {
                                error "No devices found in ${tb}"
                            }

                            def branches = [:]

                            for (d in devices) {
                                def deviceName = d
                                branches[deviceName] = {
                                    stage("Push → ${deviceName}") {
                                        sh """
                                            set -e
                                            pyats-venv/bin/python scripts/config_push.py \
                                              --testbed ${tb} \
                                              --devices ${deviceName} \
                                              --config "${params.CONFIG_COMMANDS}" \
                                              ${params.WRITE_MEMORY ? '--write-memory' : ''}
                                        """
                                    }
                                }
                            }

                            parallel branches
                        }
                    }
                }
            }
        }
    }

    /***************************************************************************
     POST ACTIONS
    ***************************************************************************/
    post {
        success {
            echo "✅ All selected testbeds completed successfully"
        }
        failure {
            echo "❌ Pipeline failed"
        }
    }
}
