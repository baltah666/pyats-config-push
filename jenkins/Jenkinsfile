/*
===============================================================================
 Jenkinsfile – pyats-config-push-v2
 Version : v2.6.2
-------------------------------------------------------------------------------
 PURPOSE:
 - Push IOS / IOS-XE configuration using pyATS + Genie + Unicon
 - Select MULTIPLE testbeds via checkbox (Extended Choice Parameter)
 - Discover devices dynamically per testbed
 - Execute config push in PARALLEL per DEVICE
 - Show DEVICE NAMES in Jenkins / Blue Ocean UI (Option #1)

 WHAT'S NEW IN v2.6.2:
 - Blue Ocean stages display device names instead of testbed filenames
 - Parallel structure flattened for operator clarity
 - Safe handling of overlapping device names across testbeds
 - Improved logging & error handling

 REQUIREMENTS:
 - Jenkins "Extended Choice Parameter" plugin
 - Python 3.11 available on agent
 - pyATS / Genie / Unicon v24.3
===============================================================================
*/

pipeline {
    agent any

    options {
        timestamps()
        ansiColor('xterm')
    }

    /***************************************************************************
     PARAMETERS
    ***************************************************************************/
    parameters {

        text(
            name: 'CONFIG_COMMANDS',
            defaultValue: '',
            description: 'IOS CLI configuration to push (multi-line supported)'
        )

        // Checkbox-style multi-select (WORKS in your environment)
        extendedChoice(
            name: 'TESTBEDS',
            type: 'PT_CHECKBOX',
            description: 'Select one or more target testbeds',
            value: '''
testbeds/testbed_access_2960.yaml,
testbeds/testbed_access_9200.yaml,
testbeds/testbed_access_9300.yaml,
testbeds/testbed_datacenter_n9k.yaml,
testbeds/testbed_routers.yaml
''',
            multiSelectDelimiter: ','
        )

        booleanParam(
            name: 'WRITE_MEMORY',
            defaultValue: true,
            description: 'Run "write memory" after pushing config'
        )
    }

    environment {
        PYTHON_BIN = "python3.11"
        VENV_DIR  = "pyats-venv"
    }

    /***************************************************************************
     STAGES
    ***************************************************************************/
    stages {

        stage('Checkout SCM') {
            steps {
                checkout scm
                echo "✅ Repository checked out"
            }
        }

        stage('Prepare Virtualenv') {
            steps {
                sh '''
                    set -e
                    if [ ! -d "${VENV_DIR}" ]; then
                        ${PYTHON_BIN} -m venv ${VENV_DIR}
                    else
                        echo "Virtualenv already exists, reusing it"
                    fi
                '''
            }
        }

        stage('Install Python Dependencies') {
            steps {
                sh '''
                    set -e
                    . ${VENV_DIR}/bin/activate
                    pip install --upgrade pip
                    pip install pyats==24.3 genie==24.3 unicon==24.3
                '''
            }
        }

        stage('Verify pyATS Environment') {
            steps {
                sh '''
                    set -e
                    . ${VENV_DIR}/bin/activate
                    python - << 'EOF'
import pyats, genie, unicon
print("pyATS / Genie / Unicon OK")
EOF
                '''
            }
        }

        /*
         ----------------------------------------------------------------------
         PUSH CONFIG — DEVICE-CENTRIC VIEW (OPTION #1)
         ----------------------------------------------------------------------
        */
        stage('Push Config (All Testbeds)') {
            steps {
                script {

                    if (!params.TESTBEDS?.trim()) {
                        error "No testbeds selected!"
                    }

                    def testbeds = params.TESTBEDS
                        .split(',')
                        .collect { it.trim() }
                        .findAll { it }

                    def deviceBranches = [:]

                    // Discover devices per testbed
                    for (tb in testbeds) {

                        def devicesRaw = sh(
                            script: """
                                . ${VENV_DIR}/bin/activate
                                ${PYTHON_BIN} scripts/config_push.py \
                                  --testbed ${tb} \
                                  --list-devices
                            """,
                            returnStdout: true
                        ).trim()

                        def devices = devicesRaw
                            .split("\\n")
                            .collect { it.trim() }
                            .findAll { it }

                        for (dev in devices) {

                            // Unique key to avoid collisions across testbeds
                            def branchKey = "${dev} (${tb.tokenize('/').last()})"

                            deviceBranches[branchKey] = {
                                stage("Push → ${dev}") {
                                    sh """
                                        set -e
                                        . ${VENV_DIR}/bin/activate
                                        ${PYTHON_BIN} scripts/config_push.py \
                                          --testbed ${tb} \
                                          --devices ${dev} \
                                          --config "${params.CONFIG_COMMANDS}" \
                                          ${params.WRITE_MEMORY ? '--write-memory' : ''}
                                    """
                                    echo "${dev} → OK"
                                }
                            }
                        }
                    }

                    if (deviceBranches.isEmpty()) {
                        error "No devices discovered from selected testbeds"
                    }

                    parallel deviceBranches
                }
            }
        }
    }

    /***************************************************************************
     POST ACTIONS
    ***************************************************************************/
    post {
        success {
            echo "✅ All selected testbeds and devices completed successfully"
        }
        failure {
            echo "❌ Pipeline failed — check logs above"
        }
    }
}
