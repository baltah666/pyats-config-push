/*
===============================================================================
 Jenkinsfile – pyats-config-push
 Version : v2.6.0
-------------------------------------------------------------------------------
 PURPOSE:
 - Push IOS configuration to network devices using pyATS + Genie
 - Support MULTIPLE testbeds (checkbox selection)
 - Run device config pushes in PARALLEL
 - Clear, readable Blue Ocean visualization

 WHAT'S NEW IN v2.6.0:
 - Multi-select TESTBEDS via Extended Choice Parameter (checkbox UI)
 - Parallel execution per DEVICE (not per testbed only)
 - Blue Ocean shows DEVICE NAMES instead of YAML filenames
 - Safe virtualenv reuse for Jenkins agents

 REQUIREMENTS:
 - Jenkins plugins:
     * Pipeline
     * Extended Choice Parameter
     * AnsiColor
     * Timestamper
 - Python 3.11 installed on Jenkins agent
===============================================================================
*/

pipeline {
    agent any

    options {
        timestamps()
        ansiColor('xterm')
    }

    /***************************************************************************
     PARAMETERS
    ***************************************************************************/
    parameters {

        /*
         ----------------------------------------------------------------------
         CONFIG_COMMANDS
         ----------------------------------------------------------------------
         - Multiline IOS CLI configuration
         - Sent exactly as entered
        */
        text(
            name: 'CONFIG_COMMANDS',
            defaultValue: '',
            description: 'IOS CLI configuration to push (multi-line supported)'
        )

        /*
         ----------------------------------------------------------------------
         TESTBEDS (MULTI-SELECT CHECKBOX)
         ----------------------------------------------------------------------
         - Uses Extended Choice Parameter plugin
         - Allows selecting multiple testbeds
        */
        extendedChoice(
            name: 'TESTBEDS',
            type: 'PT_CHECKBOX',
            description: 'Select one or more target testbeds',
            value: '''
testbeds/testbed_access_9200.yaml,
testbeds/testbed_access_9300.yaml,
testbeds/testbed_access_2960.yaml,
testbeds/testbed_datacenter_n9k.yaml,
testbeds/testbed_routers.yaml
''',
            multiSelectDelimiter: ','
        )

        /*
         ----------------------------------------------------------------------
         WRITE_MEMORY
         ----------------------------------------------------------------------
         - Controls "write memory" after config push
        */
        booleanParam(
            name: 'WRITE_MEMORY',
            defaultValue: true,
            description: 'Run "write memory" after pushing config'
        )
    }

    /***************************************************************************
     ENVIRONMENT
    ***************************************************************************/
    environment {
        PYTHON_BIN = "/usr/bin/python3.11"
        VENV_DIR   = "pyats-venv"
    }

    /***************************************************************************
     STAGES
    ***************************************************************************/
    stages {

        stage('Checkout SCM') {
            steps {
                checkout scm
                echo "✅ Repository checked out"
            }
        }

        stage('Prepare Virtualenv') {
            steps {
                sh '''
                set -e

                if [ ! -d "${VENV_DIR}" ]; then
                    ${PYTHON_BIN} -m venv ${VENV_DIR}
                fi

                ${VENV_DIR}/bin/pip install --upgrade pip
                ${VENV_DIR}/bin/pip install pyats==24.3 genie==24.3 unicon==24.3
                '''
            }
        }

        stage('Verify pyATS Environment') {
            steps {
                sh '''
                set -e
                ${VENV_DIR}/bin/python - << 'EOF'
import pyats, genie, unicon
print("pyATS / Genie / Unicon OK")
EOF
                '''
            }
        }

        /*
         ----------------------------------------------------------------------
         PUSH CONFIG (ALL TESTBEDS / ALL DEVICES)
         ----------------------------------------------------------------------
        */
        stage('Push Config (All Testbeds)') {
            steps {
                script {

                    if (!params.TESTBEDS?.trim()) {
                        error "No testbeds selected!"
                    }

                    def testbeds = params.TESTBEDS.split(',').collect { it.trim() }
                    def allBranches = [:]

                    for (tb in testbeds) {

                        // Discover devices per testbed
                        def devicesRaw = sh(
                            script: """
                                ${VENV_DIR}/bin/python scripts/config_push.py \
                                  --testbed ${tb} \
                                  --list-devices
                            """,
                            returnStdout: true
                        ).trim()

                        def devices = devicesRaw
                            .split("\\n")
                            .collect { it.trim() }
                            .findAll { it }

                        if (devices.isEmpty()) {
                            echo "⚠️ No devices found in ${tb}"
                            continue
                        }

                        for (device in devices) {

                            // BLUE OCEAN FRIENDLY LABEL
                            def label = "${device} (${tb.tokenize('/').last()})"

                            allBranches[label] = {
                                stage("Push → ${device}") {
                                    sh """
                                    set -e
                                    ${VENV_DIR}/bin/python scripts/config_push.py \
                                      --testbed ${tb} \
                                      --devices ${device} \
                                      --config "${params.CONFIG_COMMANDS}" \
                                      ${params.WRITE_MEMORY ? '--write-memory' : ''}
                                    """
                                }
                            }
                        }
                    }

                    if (allBranches.isEmpty()) {
                        error "No devices discovered from selected testbeds!"
                    }

                    parallel allBranches
                }
            }
        }
    }

    /***************************************************************************
     POST ACTIONS
    ***************************************************************************/
    post {
        success {
            echo "✅ Configuration pushed successfully to all devices"
        }
        failure {
            echo "❌ Pipeline failed — check logs above"
        }
    }
}
