/*
===============================================================================
 Jenkinsfile – pyats-config-push-v2
 Version : v2.6.0
-------------------------------------------------------------------------------
 PURPOSE:
 - Push IOS configuration using pyATS / Genie / Unicon
 - Support MULTIPLE testbeds in ONE run
 - Enforce strict testbed → device isolation
 - Show clean Blue Ocean graph (Testbed → Device)

 WHY v2.6.0 EXISTS:
 - Fixes KeyError when devices belong to different testbeds
 - Prevents running a device against the wrong testbed
 - Scales safely across access / core / datacenter testbeds

 UI FEATURES:
 - TESTBEDS uses checkbox-style multi-select
 - CONFIG_COMMANDS supports multi-line CLI
 - WRITE_MEMORY toggle supported

 REQUIRED JENKINS PLUGINS:
 - Pipeline
 - Blue Ocean (optional but recommended)
 - Extended Choice Parameter

 PYTHON REQUIREMENTS:
 - Python 3.11 installed on Jenkins agent
===============================================================================
*/

pipeline {
    agent any

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
    }

    /***************************************************************************
     PARAMETERS
    ***************************************************************************/
    parameters {

        /*
         ----------------------------------------------------------------------
         CONFIG_COMMANDS
         ----------------------------------------------------------------------
         - Multiline IOS CLI configuration
         - Passed verbatim to pyATS
        */
        text(
            name: 'CONFIG_COMMANDS',
            defaultValue: '',
            description: 'IOS CLI configuration to push (multi-line supported)'
        )

        /*
         ----------------------------------------------------------------------
         TESTBEDS (MULTI-SELECT CHECKBOX)
         ----------------------------------------------------------------------
         - Uses Extended Choice Parameter plugin
         - Allows selecting multiple testbeds safely
         - Values are RELATIVE PATHS used by pyATS
        */
        extendedChoice(
            name: 'TESTBEDS',
            type: 'PT_CHECKBOX',
            description: 'Select one or more target testbeds',
            value: '''
testbeds/testbed_access_2960.yaml,
testbeds/testbed_access_9200.yaml,
testbeds/testbed_access_9300.yaml,
testbeds/testbed_datacenter_n9k.yaml,
testbeds/testbed_routers.yaml
''',
            multiSelectDelimiter: ','
        )

        /*
         ----------------------------------------------------------------------
         WRITE_MEMORY
         ----------------------------------------------------------------------
         - Run "write memory" after pushing config
        */
        booleanParam(
            name: 'WRITE_MEMORY',
            defaultValue: true,
            description: 'Run "write memory" after pushing config'
        )
    }

    /***************************************************************************
     ENVIRONMENT
    ***************************************************************************/
    environment {
        PYTHON_BIN = "/usr/bin/python3.11"
        VENV_DIR   = "pyats-venv"
    }

    /***************************************************************************
     STAGES
    ***************************************************************************/
    stages {

        stage('Checkout SCM') {
            steps {
                checkout scm
                sh 'echo "✅ Repository checked out"'
            }
        }

        stage('Prepare Virtualenv') {
            steps {
                sh '''
                set -e
                if [ ! -d "${VENV_DIR}" ]; then
                    ${PYTHON_BIN} -m venv ${VENV_DIR}
                else
                    echo "Virtualenv already exists, reusing it"
                fi
                '''
            }
        }

        stage('Install Python Dependencies') {
            steps {
                sh '''
                set -e
                . ${VENV_DIR}/bin/activate
                pip install --upgrade pip
                pip install pyats==24.3 genie==24.3 unicon==24.3
                '''
            }
        }

        stage('Verify pyATS Environment') {
            steps {
                sh '''
                set -e
                . ${VENV_DIR}/bin/activate
                python - << 'PY'
import pyats, genie, unicon
print("pyATS / Genie / Unicon OK")
PY
                '''
            }
        }

        /*
         ----------------------------------------------------------------------
         PUSH CONFIG – ALL TESTBEDS (ISOLATED)
         ----------------------------------------------------------------------
         LOGIC:
         - Loop over selected testbeds
         - For EACH testbed:
             - Discover ONLY its devices
             - Run parallel per device
         - Impossible for a device to run on the wrong testbed
        */
        stage('Push Config (All Testbeds)') {
            steps {
                script {

                    if (!params.TESTBEDS?.trim()) {
                        error "❌ No testbeds selected"
                    }

                    def testbeds = params.TESTBEDS
                        .split(',')
                        .collect { it.trim() }
                        .findAll { it }

                    def testbedBranches = [:]

                    for (tb in testbeds) {

                        def testbedLabel = tb.tokenize('/').last()

                        testbedBranches[testbedLabel] = {
                            stage("Testbed → ${testbedLabel}") {

                                // Discover devices for THIS testbed only
                                def devicesRaw = sh(
                                    script: """
                                        . ${VENV_DIR}/bin/activate
                                        python scripts/config_push.py \
                                          --testbed ${tb} \
                                          --list-devices
                                    """,
                                    returnStdout: true
                                ).trim()

                                def devices = devicesRaw
                                    .split("\\n")
                                    .collect { it.trim() }
                                    .findAll { it }

                                if (devices.isEmpty()) {
                                    echo "⚠️ No devices found in ${testbedLabel}"
                                    return
                                }

                                def deviceBranches = [:]

                                for (dev in devices) {
                                    deviceBranches[dev] = {
                                        stage("Push → ${dev}") {
                                            sh """
                                            set -e
                                            . ${VENV_DIR}/bin/activate
                                            python scripts/config_push.py \
                                              --testbed ${tb} \
                                              --devices ${dev} \
                                              --config "${params.CONFIG_COMMANDS}" \
                                              ${params.WRITE_MEMORY ? '--write-memory' : ''}
                                            """
                                        }
                                    }
                                }

                                parallel deviceBranches
                            }
                        }
                    }

                    parallel testbedBranches
                }
            }
        }
    }

    /***************************************************************************
     POST ACTIONS
    ***************************************************************************/
    post {
        success {
            echo "✅ All selected testbeds and devices completed successfully"
        }
        failure {
            echo "❌ Pipeline failed — check stage logs above"
        }
    }
}
