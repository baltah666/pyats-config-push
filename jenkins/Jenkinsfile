// ======================================================
// Jenkinsfile
// Project : pyats-config-push
// Version : v2.1.1
//
// Purpose:
// Jenkins Pipeline to push runtime CLI configuration
// to Cisco devices using pyATS, fully parameter-driven.
//
// ------------------------------------------------------
// FIXES IN v2.1.1
// ------------------------------------------------------
// ❌ PROBLEM (v2.1.0):
// - Jenkins discovered multiple devices correctly
// - Parallel branches were created
// - BUT all branches executed against the *last device*
//   due to Groovy closure variable capture
//
// ✅ FIX (v2.1.1):
// - Introduced a local variable inside the loop:
//       def deviceName = dev
// - Each parallel closure now captures its OWN device
//
// This guarantees:
// Push → sw01
// Push → sw02
// Push → sw03
// (each in its own branch, correctly)
//
// ======================================================

pipeline {
    agent any

    options {
        timestamps()
        ansiColor('xterm')
    }

    parameters {
        text(
            name: 'CONFIG',
            description: 'CLI configuration to push (raw commands)',
            trim: true
        )
        booleanParam(
            name: 'WRITE_MEMORY',
            defaultValue: true,
            description: 'Save configuration after push'
        )
    }

    environment {
        PYTHON_BIN = 'python3.11'
        VENV_DIR  = 'pyats-venv'
        TESTBED   = 'testbeds/testbed_access_2960.yaml'
    }

    stages {

        // --------------------------------------------------
        // Task 1 – Checkout repository
        // --------------------------------------------------
        stage('Task 1 - Checkout SCM') {
            steps {
                checkout scm
                echo '✅ Repo checked out (SCM)'
            }
        }

        // --------------------------------------------------
        // Task 2.1 – Verify Python
        // --------------------------------------------------
        stage('Task 2.1 - Verify Python') {
            steps {
                sh '''
                    set -e
                    echo "Using Python:"
                    python3.11 --version
                '''
            }
        }

        // --------------------------------------------------
        // Task 2.2 – Create / Reuse Virtualenv
        // --------------------------------------------------
        stage('Task 2.2 - Create / Reuse Virtualenv') {
            steps {
                sh '''
                    set -e
                    if [ ! -d "${VENV_DIR}" ]; then
                        echo "Creating virtualenv"
                        python3.11 -m venv ${VENV_DIR}
                    else
                        echo "Virtualenv already exists, reusing it"
                    fi
                '''
            }
        }

        // --------------------------------------------------
        // Task 2.3 – Install Python dependencies
        // --------------------------------------------------
        stage('Task 2.3 - Install Python dependencies') {
            steps {
                sh '''
                    set -e
                    . ${VENV_DIR}/bin/activate
                    python -m pip install --upgrade pip

                    if [ -f requirements.txt ]; then
                        echo "Installing from requirements.txt"
                        pip install -r requirements.txt
                    else
                        echo "No requirements.txt found – installing minimal deps"
                        pip install pyats==24.3 genie==24.3 unicon==24.3
                    fi
                '''
            }
        }

        // --------------------------------------------------
        // Task 2.4 – Verify Imports
        // --------------------------------------------------
        stage('Task 2.4 - Verify Imports') {
            steps {
                sh '''
                    set -e
                    . ${VENV_DIR}/bin/activate
                    python - << 'EOF'
import pyats
import genie
import unicon
print("pyATS import OK")
print("Genie import OK")
print("Unicon import OK")
EOF
                '''
            }
        }

        // --------------------------------------------------
        // Task 3 – Push Config (Parallel per Device)
        // --------------------------------------------------
        stage('Task 3 - Push Config (Parallel per Device)') {
            steps {
                script {

                    // Discover devices from testbed
                    def deviceList = sh(
                        script: """
                            . ${VENV_DIR}/bin/activate
                            ${PYTHON_BIN} scripts/config_push.py \
                              --testbed ${TESTBED} \
                              --list-devices
                        """,
                        returnStdout: true
                    ).trim()

                    def devices = deviceList.split(',')

                    echo "Discovered devices: ${devices}"

                    def branches = [:]

                    // --------------------------------------------------
                    // IMPORTANT FIX (v2.1.1)
                    // --------------------------------------------------
                    devices.each { dev ->

                        // ✅ FIX: capture device per-iteration
                        def deviceName = dev.trim()

                        branches[deviceName] = {
                            stage("Push → ${deviceName}") {
                                sh """
                                    set -e
                                    . ${VENV_DIR}/bin/activate
                                    ${PYTHON_BIN} scripts/config_push.py \
                                      --testbed ${TESTBED} \
                                      --devices ${deviceName} \
                                      --config "${params.CONFIG}" \
                                      ${params.WRITE_MEMORY ? '--write-memory' : ''}
                                """
                            }
                        }
                    }

                    // Execute per-device in parallel
                    parallel branches
                }
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline completed successfully'
        }
        failure {
            echo '❌ Pipeline failed – check logs'
        }
    }
}
