/*
===============================================================================
 Jenkinsfile – pyats-config-push
 Version : v2.2.0
 Author  : Abdulilah Baltah
-------------------------------------------------------------------------------
 WHAT WAS FIXED IN THIS VERSION:
 - RESTORED missing TESTBED_FILE Jenkins parameter
 - Keeps the v2.1.0 fix for the Groovy parallel-closure bug
 - Each device now runs in its OWN parallel branch correctly
 - Jenkins UI now shows TESTBED_FILE again
===============================================================================
*/

pipeline {
    agent any

    options {
        timestamps()
        ansiColor('xterm')
    }

    parameters {
        /* FIX v2.2.0:
           This parameter was missing in v2.1.x,
           causing Jenkins UI not to show TESTBED_FILE
        */
        string(
            name: 'TESTBED_FILE',
            defaultValue: 'testbeds/testbed_access_2960.yaml',
            description: 'Path to pyATS testbed YAML file'
        )

        text(
            name: 'CONFIG_COMMANDS',
            defaultValue: '',
            description: 'Multiline IOS CLI configuration to push'
        )

        string(
            name: 'DEVICE_FILTER',
            defaultValue: 'ALL',
            description: 'Comma-separated device list OR ALL'
        )

        booleanParam(
            name: 'WRITE_MEMORY',
            defaultValue: true,
            description: 'Run "write memory" after pushing config'
        )
    }

    stages {

        stage('Task 1 - Checkout SCM') {
            steps {
                checkout scm
                echo '✅ Repo checked out (SCM)'
            }
        }

        stage('Task 2.1 - Verify Python') {
            steps {
                sh '''
                    set -e
                    echo "Using Python:"
                    python3.11 --version
                '''
            }
        }

        stage('Task 2.2 - Create / Reuse Virtualenv') {
            steps {
                sh '''
                    set -e
                    if [ ! -d pyats-venv ]; then
                        python3.11 -m venv pyats-venv
                        echo "Virtualenv created"
                    else
                        echo "Virtualenv already exists, reusing it"
                    fi
                '''
            }
        }

        stage('Task 2.3 - Install Python dependencies') {
            steps {
                sh '''
                    set -e
                    . pyats-venv/bin/activate
                    python -m pip install --upgrade pip

                    if [ -f requirements.txt ]; then
                        pip install -r requirements.txt
                    else
                        echo "No requirements.txt found – installing minimal deps"
                        pip install pyats==24.3 genie==24.3 unicon==24.3
                    fi
                '''
            }
        }

        stage('Task 2.4 - Verify Imports') {
            steps {
                sh '''
                    set -e
                    . pyats-venv/bin/activate
                    python - << 'EOF'
import pyats
import genie
import unicon
print("pyATS import OK")
print("Genie import OK")
print("Unicon import OK")
EOF
                '''
            }
        }

        stage('Task 3 - Push Config (Parallel per Device)') {
            steps {
                script {

                    sh '. pyats-venv/bin/activate'

                    def devicesRaw = sh(
                        script: """
                            python3.11 scripts/config_push.py \
                              --testbed ${params.TESTBED_FILE} \
                              --list-devices
                        """,
                        returnStdout: true
                    ).trim()

                    def devices = devicesRaw
                        .replace('[', '')
                        .replace(']', '')
                        .split('\\n')
                        .collect { it.trim() }
                        .findAll { it }

                    echo "Discovered devices: ${devices}"

                    def branches = [:]

                    /* FIX KEPT FROM v2.1.0:
                       Device variable must be captured per-closure
                       to avoid sw03 repetition bug
                    */
                    for (int i = 0; i < devices.size(); i++) {
                        def deviceName = devices[i]

                        branches[deviceName] = {
                            stage("Push → ${deviceName}") {
                                sh """
                                    set -e
                                    . pyats-venv/bin/activate

                                    python3.11 scripts/config_push.py \
                                      --testbed ${params.TESTBED_FILE} \
                                      --devices ${deviceName} \
                                      --config "${params.CONFIG_COMMANDS}" \
                                      ${params.WRITE_MEMORY ? '--write-memory' : ''}
                                """
                            }
                        }
                    }

                    parallel branches
                }
            }
        }
    }

    post {
        success {
            echo '✅ Configuration push completed successfully'
        }
        failure {
            echo '❌ Pipeline failed – check logs'
        }
    }
}
