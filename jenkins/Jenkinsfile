// ======================================================
// Jenkinsfile
// Project : pyats-config-push
// Version : v2.1.3
//
// ------------------------------------------------------
// FIXES IN v2.1.3
// ------------------------------------------------------
//
// FIX #1 (CRITICAL):
// - Fail pipeline immediately if CONFIG parameter is empty
// - Prevents "--config \"\"" from being passed to Python
//
// FIX #2 (FROM v2.1.2):
// - Correct device list parsing (newline-safe)
// - Correct variable capture for parallel branches
//
// ======================================================

pipeline {
    agent any

    options {
        timestamps()
        ansiColor('xterm')
    }

    parameters {
        text(
            name: 'CONFIG',
            description: 'CLI configuration to push (required)',
            trim: true
        )
        booleanParam(
            name: 'WRITE_MEMORY',
            defaultValue: true,
            description: 'Save configuration after push'
        )
    }

    environment {
        PYTHON_BIN = 'python3.11'
        VENV_DIR  = 'pyats-venv'
        TESTBED   = 'testbeds/testbed_access_2960.yaml'
    }

    stages {

        stage('Task 0 - Validate Input') {
            steps {
                script {
                    if (!params.CONFIG?.trim()) {
                        error """
❌ CONFIG parameter is empty

You must provide CLI configuration, for example:

ip http server
no ip domain-lookup
interface vlan 1
 description Managed by Jenkins
"""
                    }
                }
            }
        }

        stage('Task 1 - Checkout SCM') {
            steps {
                checkout scm
                echo '✅ Repo checked out'
            }
        }

        stage('Task 2.1 - Verify Python') {
            steps {
                sh 'python3.11 --version'
            }
        }

        stage('Task 2.2 - Create / Reuse Virtualenv') {
            steps {
                sh '''
                    if [ ! -d "${VENV_DIR}" ]; then
                        python3.11 -m venv ${VENV_DIR}
                    else
                        echo "Reusing virtualenv"
                    fi
                '''
            }
        }

        stage('Task 2.3 - Install Dependencies') {
            steps {
                sh '''
                    . ${VENV_DIR}/bin/activate
                    python -m pip install --upgrade pip
                    pip install pyats==24.3 genie==24.3 unicon==24.3
                '''
            }
        }

        stage('Task 3 - Push Config (Parallel per Device)') {
            steps {
                script {

                    def raw = sh(
                        script: """
                            . ${VENV_DIR}/bin/activate
                            ${PYTHON_BIN} scripts/config_push.py \
                              --testbed ${TESTBED} \
                              --list-devices
                        """,
                        returnStdout: true
                    ).trim()

                    def devices = raw
                        .split('\\n')
                        .collect { it.trim() }
                        .findAll { it }

                    if (devices.isEmpty()) {
                        error "❌ No devices discovered"
                    }

                    echo "Target devices: ${devices}"

                    def branches = [:]

                    devices.each { dev ->
                        def deviceName = dev   // ✅ REQUIRED for Groovy closure safety

                        branches[deviceName] = {
                            stage("Push → ${deviceName}") {
                                sh """
                                    . ${VENV_DIR}/bin/activate
                                    ${PYTHON_BIN} scripts/config_push.py \
                                      --testbed ${TESTBED} \
                                      --devices ${deviceName} \
                                      --config "${params.CONFIG}" \
                                      ${params.WRITE_MEMORY ? '--write-memory' : ''}
                                """
                            }
                        }
                    }

                    parallel branches
                }
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline completed successfully'
        }
        failure {
            echo '❌ Pipeline failed'
        }
    }
}
