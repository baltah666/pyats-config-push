/*
===============================================================================
 Jenkinsfile – pyats-config-push
 Version : v2.3.1
-------------------------------------------------------------------------------
 FIX IN THIS VERSION:
 - Replaced Active Choices (INVALID in Declarative Pipeline)
 - Uses Declarative-safe choice() parameter
 - Restores pipeline compatibility with Jenkinsfile-from-SCM

 PREVIOUS FIXES:
 - v2.2.1: Explicit pyats-venv/bin/python usage
 - Fixed ModuleNotFoundError: pyats
 - Stable parallel execution per device

 PURPOSE:
 - Push IOS configuration to multiple devices using pyATS
 - Show per-device parallel execution graph
===============================================================================
*/

pipeline {
    agent any

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
    }

    /***************************************************************************
     PARAMETERS
    ***************************************************************************/
    parameters {

        /*
         ----------------------------------------------------------------------
         TESTBED_FILE (DROPDOWN – Declarative SAFE)
         ----------------------------------------------------------------------
         - Static list (SCM-controlled)
         - Prevents typos
         - Jenkinsfile compatible
        */
        choice(
            name: 'TESTBED_FILE',
            choices: [
                'testbeds/testbed_access_2960.yaml',
                'testbeds/testbed_access_9200.yaml'
            ],
            description: 'Select pyATS testbed YAML file'
        )

        /*
         ----------------------------------------------------------------------
         CONFIG_COMMANDS
         ----------------------------------------------------------------------
         - Multiline IOS CLI config
         - Sent exactly as entered
        */
        text(
            name: 'CONFIG_COMMANDS',
            defaultValue: '',
            description: 'Multiline IOS CLI configuration to push'
        )

        /*
         ----------------------------------------------------------------------
         DEVICE_FILTER
         ----------------------------------------------------------------------
         - ALL = all devices
         - Or comma-separated list
        */
        string(
            name: 'DEVICE_FILTER',
            defaultValue: 'ALL',
            description: 'Comma-separated device list OR ALL'
        )

        /*
         ----------------------------------------------------------------------
         WRITE_MEMORY
         ----------------------------------------------------------------------
         - Controls "write memory"
        */
        booleanParam(
            name: 'WRITE_MEMORY',
            defaultValue: true,
            description: 'Run "write memory" after pushing config'
        )
    }

    /***************************************************************************
     STAGES
    ***************************************************************************/
    stages {

        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        stage('Prepare Virtualenv') {
            steps {
                sh '''
                    set -e
                    if [ ! -d pyats-venv ]; then
                        python3.11 -m venv pyats-venv
                    fi

                    pyats-venv/bin/pip install --upgrade pip
                    pyats-venv/bin/pip install pyats==24.3 genie==24.3 unicon==24.3
                '''
            }
        }

        stage('Verify pyATS Environment') {
            steps {
                sh '''
                    set -e
                    pyats-venv/bin/python - << 'EOF'
import pyats
import genie
import unicon
print("pyATS environment OK")
EOF
                '''
            }
        }

        stage('Push Config (Parallel per Device)') {
            steps {
                script {

                    // Discover devices
                    def devicesRaw = sh(
                        script: """
                            pyats-venv/bin/python scripts/config_push.py \
                              --testbed ${params.TESTBED_FILE} \
                              --list-devices
                        """,
                        returnStdout: true
                    ).trim()

                    def devices = devicesRaw
                        .split("\\n")
                        .collect { it.trim() }
                        .findAll { it }

                    if (devices.isEmpty()) {
                        error "No devices discovered from testbed!"
                    }

                    def branches = [:]

                    for (String deviceName : devices) {
                        branches[deviceName] = {
                            stage("Push → ${deviceName}") {
                                sh """
                                    set -e
                                    pyats-venv/bin/python scripts/config_push.py \
                                      --testbed ${params.TESTBED_FILE} \
                                      --devices ${deviceName} \
                                      --config "${params.CONFIG_COMMANDS}" \
                                      ${params.WRITE_MEMORY ? '--write-memory' : ''}
                                """
                            }
                        }
                    }

                    parallel branches
                }
            }
        }
    }

    /***************************************************************************
     POST
    ***************************************************************************/
    post {
        success {
            echo "✅ All devices completed successfully"
        }
        failure {
            echo "❌ Pipeline failed"
        }
    }
}
