/*
===============================================================================
 Jenkinsfile – pyats-config-push-v2
 Version : v2.3.0
-------------------------------------------------------------------------------
 PURPOSE:
 - Push IOS configuration to multiple devices using pyATS + Genie
 - Run per-device in parallel
 - Safe Jenkins virtualenv handling

 WHAT'S NEW IN v2.3.0:
 - TESTBED_FILE converted from free-text to SELECT DROPDOWN
 - Uses Active Choices Plugin
 - Prevents typos & invalid testbed paths
 - Cleaner UI for operators

 PREVIOUS FIXES (v2.2.1):
 - Explicit pyats-venv/bin/python usage
 - Fixed "ModuleNotFoundError: pyats"
 - Jenkins-safe venv execution

 REQUIREMENTS:
 - Jenkins Active Choices Plugin
 - Python 3.11 available on Jenkins agent
===============================================================================
*/

pipeline {
    agent any

    options {
        timestamps()
        ansiColor('xterm')
    }

    /***************************************************************************
     PARAMETERS
    ***************************************************************************/
    parameters {

        /*
         ----------------------------------------------------------------------
         TESTBED_FILE (DROPDOWN)
         ----------------------------------------------------------------------
         - Uses Active Choices Plugin
         - Prevents manual typing errors
         - List can be extended safely
        */
        activeChoiceParam('TESTBED_FILE') {
            description('Select pyATS testbed YAML file')
            choiceType('SINGLE_SELECT')

            groovyScript {
                script("""
                    return [
                        'testbeds/testbed_access_2960.yaml',
                        'testbeds/testbed_access_9200.yaml',
                        'testbeds/testbed_access_9300.yaml',
                        'testbeds/testbed_datacenter_n9k.yaml',
                        'testbeds/testbed_routers.yaml'
                    ]
                """)
                fallbackScript("return ['ERROR_LOADING_TESTBEDS']")
            }
        }

        /*
         ----------------------------------------------------------------------
         CONFIG_COMMANDS
         ----------------------------------------------------------------------
         - Multiline IOS CLI config
         - Sent exactly as entered
        */
        text(
            name: 'CONFIG_COMMANDS',
            defaultValue: '',
            description: 'Multiline IOS CLI configuration to push'
        )

        /*
         ----------------------------------------------------------------------
         DEVICE_FILTER
         ----------------------------------------------------------------------
         - ALL = push to all devices in testbed
         - Or comma-separated list (future use)
        */
        string(
            name: 'DEVICE_FILTER',
            defaultValue: 'ALL',
            description: 'Comma-separated device list OR ALL'
        )

        /*
         ----------------------------------------------------------------------
         WRITE_MEMORY
         ----------------------------------------------------------------------
         - Controls "write memory" after config push
        */
        booleanParam(
            name: 'WRITE_MEMORY',
            defaultValue: true,
            description: 'Run "write memory" after pushing config'
        )
    }

    /***************************************************************************
     STAGES
    ***************************************************************************/
    stages {

        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        /*
         ----------------------------------------------------------------------
         PREPARE VIRTUALENV
         ----------------------------------------------------------------------
         - Creates pyats-venv if missing
         - Installs pinned pyATS stack
        */
        stage('Prepare Virtualenv') {
            steps {
                sh '''
                    set -e

                    if [ ! -d pyats-venv ]; then
                        python3.11 -m venv pyats-venv
                    fi

                    pyats-venv/bin/pip install --upgrade pip
                    pyats-venv/bin/pip install pyats==24.3 genie==24.3 unicon==24.3
                '''
            }
        }

        /*
         ----------------------------------------------------------------------
         VERIFY pyATS ENVIRONMENT
         ----------------------------------------------------------------------
         - Fails fast if pyATS stack is broken
        */
        stage('Verify pyATS Environment') {
            steps {
                sh '''
                    set -e
                    pyats-venv/bin/python - << 'EOF'
import pyats
import genie
import unicon
print("pyATS environment OK")
EOF
                '''
            }
        }

        /*
         ----------------------------------------------------------------------
         PUSH CONFIG (PARALLEL PER DEVICE)
         ----------------------------------------------------------------------
         - Discovers devices dynamically from testbed
         - Creates one parallel branch per device
         - Each device gets isolated execution
        */
        stage('Push Config (Parallel per Device)') {
            steps {
                script {

                    // Discover devices from testbed
                    def devicesRaw = sh(
                        script: """
                            pyats-venv/bin/python scripts/config_push.py \
                              --testbed ${params.TESTBED_FILE} \
                              --list-devices
                        """,
                        returnStdout: true
                    ).trim()

                    def devices = devicesRaw
                        .split("\\n")
                        .collect { it.trim() }
                        .findAll { it }

                    if (devices.isEmpty()) {
                        error "No devices discovered from testbed!"
                    }

                    def branches = [:]

                    for (int i = 0; i < devices.size(); i++) {
                        def deviceName = devices[i]

                        branches[deviceName] = {
                            stage("Push → ${deviceName}") {
                                sh """
                                    set -e
                                    pyats-venv/bin/python scripts/config_push.py \
                                      --testbed ${params.TESTBED_FILE} \
                                      --devices ${deviceName} \
                                      --config "${params.CONFIG_COMMANDS}" \
                                      ${params.WRITE_MEMORY ? '--write-memory' : ''}
                                """
                            }
                        }
                    }

                    parallel branches
                }
            }
        }
    }

    /***************************************************************************
     POST ACTIONS
    ***************************************************************************/
    post {
        success {
            echo "✅ All devices completed successfully"
        }
        failure {
            echo "❌ Pipeline failed"
        }
    }
}
