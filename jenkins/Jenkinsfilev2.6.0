/*
===============================================================================
 Jenkinsfile – pyats-config-push-v2
 Version : v2.6.0
-------------------------------------------------------------------------------
 PURPOSE:
 - Push IOS configuration using pyATS + Genie
 - Supports MULTI-SELECT testbeds (checkbox UI)
 - Runs devices in parallel per testbed

 WHY THIS VERSION WORKS:
 - Active Choices parameters defined via `properties()` (REQUIRED)
 - Declarative pipeline kept clean
 - Fully Jenkins-compliant (no compilation errors)

 REQUIREMENTS:
 - Jenkins Active Choices Plugin
 - Python 3.11 on agent
===============================================================================
*/

/***************************************************************************
 ACTIVE CHOICES PARAMETERS (MUST BE OUTSIDE pipeline {})
***************************************************************************/
properties([
  parameters([

    [
      $class      : 'ChoiceParameter',
      name        : 'TESTBEDS',
      description : 'Select one or more pyATS testbed YAML files',
      choiceType  : 'PT_CHECKBOX',
      filterable  : true,
      script      : [
        $class: 'GroovyScript',
        script: [
          sandbox: true,
          script: '''
            return [
              "testbeds/testbed_access_2960.yaml",
              "testbeds/testbed_access_9200.yaml",
              "testbeds/testbed_access_9300.yaml",
              "testbeds/testbed_datacenter_n9k.yaml",
              "testbeds/testbed_routers.yaml"
            ]
          '''
        ],
        fallbackScript: [
          sandbox: true,
          script: 'return ["ERROR_LOADING_TESTBEDS"]'
        ]
      ]
    ],

    text(
      name: 'CONFIG_COMMANDS',
      defaultValue: '',
      description: 'Multiline IOS CLI configuration to push'
    ),

    booleanParam(
      name: 'WRITE_MEMORY',
      defaultValue: true,
      description: 'Run "write memory" after pushing config'
    )
  ])
])

/***************************************************************************
 DECLARATIVE PIPELINE
***************************************************************************/
pipeline {
  agent any

  options {
    timestamps()
    ansiColor('xterm')
  }

  stages {

    stage('Checkout SCM') {
      steps {
        checkout scm
      }
    }

    stage('Prepare Virtualenv') {
      steps {
        sh '''
          set -e
          if [ ! -d pyats-venv ]; then
            python3.11 -m venv pyats-venv
          fi
          pyats-venv/bin/pip install --upgrade pip
          pyats-venv/bin/pip install pyats==24.3 genie==24.3 unicon==24.3
        '''
      }
    }

    stage('Verify pyATS Environment') {
      steps {
        sh '''
          set -e
          pyats-venv/bin/python - << 'EOF'
import pyats, genie, unicon
print("pyATS environment OK")
EOF
        '''
      }
    }

    stage('Push Config (All Testbeds)') {
      steps {
        script {

          if (!params.TESTBEDS?.trim()) {
            error "No testbeds selected!"
          }

          // Active Choices returns comma-separated string
          def testbeds = params.TESTBEDS
            .split(',')
            .collect { it.trim() }
            .findAll { it }

          echo "Selected testbeds: ${testbeds}"

          for (tb in testbeds) {

            echo "Processing testbed: ${tb}"

            def devicesRaw = sh(
              script: """
                pyats-venv/bin/python scripts/config_push.py \
                  --testbed ${tb} \
                  --list-devices
              """,
              returnStdout: true
            ).trim()

            def devices = devicesRaw
              .split("\\n")
              .collect { it.trim() }
              .findAll { it }

            if (devices.isEmpty()) {
              echo "No devices found in ${tb}"
              continue
            }

            def branches = [:]

            for (d in devices) {
              def deviceName = d
              branches["${tb} → ${deviceName}"] = {
                stage("Push → ${deviceName}") {
                  sh """
                    set -e
                    pyats-venv/bin/python scripts/config_push.py \
                      --testbed ${tb} \
                      --devices ${deviceName} \
                      --config "${params.CONFIG_COMMANDS}" \
                      ${params.WRITE_MEMORY ? '--write-memory' : ''}
                  """
                }
              }
            }

            parallel branches
          }
        }
      }
    }
  }

  post {
    success {
      echo "✅ All selected testbeds completed successfully"
    }
    failure {
      echo "❌ Pipeline failed"
    }
  }
}
